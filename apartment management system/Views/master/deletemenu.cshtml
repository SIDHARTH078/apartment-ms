@model apartment_management_system.Models.menu

@{
    ViewData["Title"] = "Delete Menu";
}
<div class="container mt-5">
    <h2 class="text-danger">area you sure you want to delete this user?</h2>
    <hr />


    <div class="card p-4 bg-gradient">
        <dl class="row mb-0">
            <dt class="col-sm-2">OwnerID:</dt>
            <dd class="col-sm-10">@Model.OwnerID</dd>

            <dt class="col-sm-2">FullName:</dt>
            <dd class="col-sm-10">@Model.FullName</dd>

            <dt class="col-sm-2">Phone:</dt>
            <dd class="col-sm-10">@Model.Phone</dd>

            <dt class="col-sm-2">Email:</dt>
            <dd class="col-sm-10">@Model.Email</dd>

            <dt class="col-sm-2">FlatNumber:</dt>
            <dd class="col-sm-10">@Model.FlatNumber</dd>
        </dl>
    </div>


     
    <form asp-action="deletemenu" method="post" class="mt-3">
        <input type="hidden" asp-for="OwnerID" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>


